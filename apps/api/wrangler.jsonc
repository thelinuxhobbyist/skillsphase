{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Bind Neon via Hyperdrive in staging/production. Locally, use DATABASE_URL in .dev.vars.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive_id>" }],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "horizon-uploads",
      "preview_bucket_name": "horizon-uploads-preview"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "DATA_RETENTION_DAYS": "30",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:3000,https://horizon-web.yama.workers.dev"
  },
  // Enable after deploy; runs daily retention purge for soft-deleted accounts.
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
